# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit real credentials.
# The suite ships with safe fallback defaults in helpers.js so it runs
# out of the box without a .env file. Create one if you need to override
# an account (e.g. to test with a personal staging account instead of
# the shared team ones).
#
# How to load in Playwright runs (Node 20.6+):
#   node --env-file=.env node_modules/.bin/playwright test
# Or set these in your CI/CD secrets manager and they will be picked up
# automatically via process.env.

# Agent A (primary test account)
AGENT_USERNAME=mutty@moniepoint.com
AGENT_PASSWORD=password@1

